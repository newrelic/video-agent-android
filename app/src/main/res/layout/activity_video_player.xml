<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VideoPlayer">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <Button
        android:id="@+id/btn_tc0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Run TC0: Baseline"
        app:layout_constraintTop_toBottomOf="@id/player"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btn_tc1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Run TC1: Happy Path"
        app:layout_constraintTop_toBottomOf="@id/btn_tc0"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btn_tc2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Run TC2: Stress/Error"
        app:layout_constraintTop_toBottomOf="@id/btn_tc1"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
